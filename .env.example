# La demo funciona sin estas variables. Copia a .env.local para /workspace.
DATABASE_URL=
BETTER_AUTH_URL=http://localhost:3000
# Generar aleatoriamente: mínimo 32 caracteres. Nunca usar un ejemplo fijo.
BETTER_AUTH_SECRET=
# Sólo staging con registros de prueba; desactivar antes de publicar.
ALLOW_SIGNUP=false
FACTURIA_ENCRYPTION_SECRET=
# SMTP propio o proveedor gratuito. Requiere TLS; claves sólo servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
REQUIRE_EMAIL_VERIFICATION=false
# Resend HTTPS permite plan gratuito de correo sin SMTP saliente en Railway Hobby.
MAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=
# Límite global por 24 h: 1..100, predeterminado20. No activar planes pagos.
MAIL_DAILY_LIMIT=20
